# Every variable the stack reads. Placeholder values only — `make dev-env` writes infra/.env with
# random secrets for each `change-me` value and never overwrites an existing file.

# --- PostgreSQL (compose) ---
POSTGRES_USER=pip
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pip
# Used when running apps on the host against the dev stack (make dev-deps)
DATABASE_URL=postgres://pip:change-me@localhost:15432/pip
DATABASE_POOL_MAX=10

# --- Redis ---
REDIS_URL=redis://localhost:16379

# --- Ports (host runs) ---
API_PORT=3001
MCP_PORT=3002

# --- Auth and secrets (OQ-002, OQ-021) ---
SESSION_SECRET=change-me
SECRETS_ENCRYPTION_KEY=change-me

# --- GitHub App (T-003, T-040) — fill from the test App; never commit real values ---
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=change-me
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# --- Release / proxy ---
PIP_VERSION=0.1.0
PIP_IMAGE_REGISTRY=ghcr.io/OWNER
SITE_ADDRESS=:80

# --- Dev proxy host port (make dev-up) ---
PIP_HTTP_PORT=8088
PIP_PG_PORT=15432
PIP_REDIS_PORT=16379
