{
  "name": "project-intelligence-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build && pnpm -r --filter './apps/*' run build",
    "lint": "biome check . && depcruise apps packages --config .dependency-cruiser.cjs",
    "format": "biome check --write .",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "schemas": "node --conditions=source --import tsx packages/contracts/scripts/export-schemas.ts",
    "dev": "pnpm -r --parallel --filter './apps/*' run dev",
    "db:migrate": "node --conditions=source --import tsx packages/db/scripts/migrate.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@pip/api": "workspace:*",
    "@pip/contracts": "workspace:*",
    "@pip/db": "workspace:*",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.1",
    "dependency-cruiser": "18.8.0",
    "drizzle-orm": "0.45.4",
    "ioredis": "6.0.0",
    "postgres": "4.1.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.1",
    "yaml": "2.9.1"
  }
}
