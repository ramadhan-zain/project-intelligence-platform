  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "dependencies": {
    "@pip/contracts": "workspace:*",
    "drizzle-orm": "0.45.4",
    "postgres": "4.1.1"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.11"
  }
}
